# Next.js reads .env.local, not .env.example. Restart after changing it.
# Leave both values empty to use the separate local database at data/wlhl.db.
# For a shared remote database or Vercel, set the real Turso URL and token.
# Never prefix database credentials with NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Change this before deploying. The local-only fallback is wlhl-admin.
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-another-long-random-secret

# Club contact and payment details shown to buyers.
NEXT_PUBLIC_CLUB_EMAIL=hello@wlhlclub.org
NEXT_PUBLIC_CLUB_PHONE=(202) 555-0148
NEXT_PUBLIC_ZELLE_HANDLE=payments@wlhlclub.org
NEXT_PUBLIC_ZELLE_RECIPIENT=Washington Longevity Healthy Life Club

# Optional browser push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@wlhlclub.org

# Stripe hosted Checkout uses only a server-side test secret key.
# Live keys are intentionally rejected by this test shop.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (or stripe listen during local testing).
STRIPE_WEBHOOK_SECRET=

# Optional Fuint content service (public article reads and media only).
# FUINT_API_URL=https://your-content-backend.example.com
# FUINT_MERCHANT_NO=10001
# Merchant allowed to publish club events using existing Fuint manager accounts.
# FUINT_MERCHANT_ID=1
